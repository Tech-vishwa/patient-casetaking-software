# MediKiosk - Supabase Configuration
# To connect your live Supabase project, replace the values below:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# If left as placeholder or empty, MediKiosk automatically runs with its built-in resilient local storage database engine for zero-setup demo!
